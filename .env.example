# Backend/server configuration only. Do not put these values in frontend/.env.local.
BACKTESTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Strategy Builder provider selection. Fake remains the safe default.
BACKTESTER_AI_ENABLED=true
BACKTESTER_AI_PROVIDER=fake
BACKTESTER_AI_MODEL=
BACKTESTER_AI_API_KEY=
BACKTESTER_AI_BASE_URL=
BACKTESTER_AI_TIMEOUT_SECONDS=
